# Copiar a .env y ajustar. convertir.sh lo pasa al contenedor con --env-file
# (y lee IMAGEN y DOCLING_CPUS para el propio comando podman).
# Formato: KEY=VALOR, sin comillas ni espacios (así lo exige --env-file).

# Hilos de inferencia. 16 aprovecha los núcleos P con hyperthreading;
# más de 20 no mejora y compite con el escritorio.
DOCLING_NUM_THREADS=16
# Debe ser igual a DOCLING_NUM_THREADS.
OMP_NUM_THREADS=16
# Límite de CPU del contenedor (podman --cpus).
DOCLING_CPUS=16

# Escala de las imágenes exportadas (2.0 ≈ 144 DPI). 1.0 es más rápido pero borroso.
DOCLING_IMAGES_SCALE=2.0
# Segundos máximos por documento antes de marcarlo como fallido.
DOCLING_TIMEOUT_DOC=600

# NO CAMBIAR. Ruta absoluta de los modelos dentro del contenedor.
DOCLING_ARTIFACTS_PATH=/modelos
# NO CAMBIAR en conversión. Impide cualquier intento de descarga.
HF_HUB_OFFLINE=1

# Tag de imagen que usan los scripts.
IMAGEN=docling-local:0.1.0
